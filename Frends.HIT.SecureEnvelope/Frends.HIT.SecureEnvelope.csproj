<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <!-- Kept true: Frends reads the packed .xml to render task and parameter
             descriptions in the process editor. Turning it off would silence
             CS1591 too, but would quietly degrade the Frends UI. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- CS1591 "missing XML comment for publicly visible type or member":
             42 occurrences, all in Definitions.cs. The docs are being written
             properly in the net10.0 replacement task rather than retrofitted
             here, so the warning is suppressed instead of drowned out. -->
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <Title>Frends SecureEnvelope Library</Title>
        <Authors>Örnsköldsviks kommun</Authors>
        <Description>Frends task for Nordea's Secure Envelope: builds a signed BXD ApplicationRequest for delivery over SFTP, and parses the ApplicationResponse returned by the bank. Fork of Frends.HIT.SecureEnvelope by Lars Scheibling, Höglandets IT.</Description>
        <Copyright>Copyright (c) Höglandets IT. MIT licensed. Maintained by Örnsköldsviks kommun.</Copyright>
        <RepositoryUrl>https://github.com/ornskoldsvikskommun/Frends.HIT.SecureEnvelope</RepositoryUrl>
        <PackageProjectUrl>https://github.com/ornskoldsvikskommun/Frends.HIT.SecureEnvelope</PackageProjectUrl>
        <Version>3.0.0</Version>
    </PropertyGroup>
    <ItemGroup>
      <None Include="FrendsTaskMetadata.json" Pack="true" PackagePath="/">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="System.Security.Cryptography.Xml" Version="8.0.4" />
    </ItemGroup>
</Project>
