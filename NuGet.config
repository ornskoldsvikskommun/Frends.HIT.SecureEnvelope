<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    nuget.org is listed explicitly so the NuGet audit configured in
    Directory.Build.props always has a source that supplies vulnerability
    data. Without one the audit runs, finds nothing, and reports NU1905 -
    a silent pass that looks identical to "no vulnerabilities".

    Deliberately no <clear />: the release workflow adds the Frends package
    feed at run time with `dotnet nuget add source`, and clearing here would
    be an easy way to break publishing for no benefit.
  -->

  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

</configuration>
